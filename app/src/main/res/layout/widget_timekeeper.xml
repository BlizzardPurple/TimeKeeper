<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FF1A1A1A">

    <!-- Row 1: Status + Today duration -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <View
            android:id="@+id/status_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="#FF666666" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OUT"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:paddingStart="6dp"
            android:paddingEnd="0dp" />

        <TextView
            android:id="@+id/today_duration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="0h 0m"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFBBBBBB" />
    </LinearLayout>

    <!-- Row 2: Week total -->
    <TextView
        android:id="@+id/week_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Week: 0h 0m"
        android:textSize="12sp"
        android:textColor="#FF999999"
        android:paddingBottom="2dp" />

    <!-- Row 3: Days count -->
    <TextView
        android:id="@+id/days_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Days: 0/3"
        android:textSize="12sp"
        android:textColor="#FF999999" />

    <!-- Spacer to push button to bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Toggle button at bottom -->
    <Button
        android:id="@+id/toggle_button"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="CHECK IN"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        android:backgroundTint="#FF4CAF50"
        android:textAllCaps="true" />

</LinearLayout>
